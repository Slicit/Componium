# Go
/bin/
*.test
*.out

# Node / studio
node_modules/
dist/
.vite/

# Firmware
.pio/
build/

# Local rig configuration and captured media - never commit
/rig.local.toml
/scores/local/
*.mkv
*.mp4

.DS_Store

# Go writes main-package executables into the working directory, so a casual
# `go build ./...` drops binaries in the repo root. Prefer `go vet ./...` to
# check, or `go build -o bin/ ./...`.
/componium
/clock-jitter

# Scores generated by the demonstration stack, but keep the directory.
deploy/scores/*
!deploy/scores/.gitkeep
node_modules/

# Per box paths, not the same on any two machines.
deploy/.env

# Scratch commit message, never committed.
.commitmsg

# Python bytecode, which the composer regenerates on every run.
__pycache__/
*.pyc
