# Go
/bin/
*.test
*.out

# Node / studio
node_modules/
dist/
.vite/

# Firmware
.pio/
build/

# Local rig configuration and captured media - never commit
/rig.local.toml
/scores/local/
*.mkv
*.mp4

.DS_Store

# Go writes main-package executables into the working directory, so a casual
# `go build ./...` drops binaries in the repo root. Prefer `go vet ./...` to
# check, or `go build -o bin/ ./...`.
/componium
/clock-jitter

# Scores generated by the demonstration stack, but keep the directory.
deploy/scores/*
!deploy/scores/.gitkeep
node_modules/

# Per box paths, not the same on any two machines.
deploy/.env

# Scratch commit message, never committed.
.commitmsg

# Python bytecode, which the composer regenerates on every run.
__pycache__/
*.pyc

# ESP-IDF build output and the packaged web installer: artifacts of a
# different toolchain, on a different release schedule.
firmware/esp32/build/
firmware/esp32/web/
firmware/esp32/sdkconfig
firmware/esp32/sdkconfig.old
firmware/esp32/dependencies.lock
firmware/esp32/managed_components/

# Which boards exist and how to authenticate to them. Credentials, and there is
# no changing a board's secret except over USB.
boards.toml
**/boards.toml

# The same, for the firmware tests, which are their own IDF project.
firmware/esp32/test/build/
firmware/esp32/test/sdkconfig
firmware/esp32/test/sdkconfig.old
firmware/esp32/test/dependencies.lock
firmware/esp32/test/managed_components/
