# A tiny score, enough to see the whole system work.
# Play it against any file with: componium play -score examples/demo.componium -rig examples/demo-rig.toml

[score]
componium = "0.1"
title = "Demo"

[score.media]
duration = "00:02:00.000"
fps = 24.0

# A cue track: discrete events. The fan is told 1.2s early, automatically,
# because that is what its manifest declares it needs.
[[track]]
instrument = "wind.main"
type = "cue"
cues = [
  { t = "00:00:10.000", action = "gust", params = { intensity = 0.8 }, duration = "4s" },
  { t = "00:00:30.000", action = "gust", params = { intensity = 0.4 }, duration = "2s" },
  { t = "00:01:00.000", action = "gust", params = { intensity = 1.0 }, duration = "6s" },
]

# A curve track: a continuous channel. Sunrise over twenty seconds, then held.
[[track]]
instrument = "light.ambient"
type = "curve"
interpolation = "linear"
points = [
  { t = "00:00:00.000", value = { r = 0.0, g = 0.0, b = 0.0 } },
  { t = "00:00:20.000", value = { r = 1.0, g = 0.6, b = 0.2 } },
  { t = "00:00:40.000", value = { r = 0.2, g = 0.2, b = 0.5 } },
]
